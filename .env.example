# Copy to `.env` for local development. Never commit `.env`.
#
# Only non-secret VITE_* values belong here — they are embedded in the browser bundle.
# Stedi / pVerify API keys and secrets must be configured in Settings (stored server-side)
# and called via `${VITE_API_BASE_URL}/integrations/stedi/*` and `/integrations/pverify/*`.

# HealthLynk backend API base URL
# Auth: httpOnly JWT cookie (access_token_cookie) — no token in localStorage/sessionStorage.
# All API calls use credentials: include + X-CSRF-TOKEN from csrf_access_token cookie.
#
# Local dev: leave unset — Vite proxies http://localhost:5173/api → Azure (vite.config.js).
# Direct Azure URL (cross-site cookies often fail): VITE_API_BASE_URL=https://healthlynkapi-....azurewebsites.net/api
# Production (healthlynk.ai): same-origin /api — link App Service to SWA (docs/PRODUCTION_AUTH_COOKIES.md).
# VITE_API_BASE_URL=/api
VITE_API_BASE_URL=
# VITE_FORCE_SAME_ORIGIN_API=true

# Healthify NPI endpoint (optional override)
# VITE_HEALTHIFY_NPI_URL=

# When VITE_API_BASE_URL=/api: proxy target (default https://healthlynk.ai — same as production).
# Local Flask only: VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:5000
# Avoid: https://healthlynkapi-....azurewebsites.net (platform auth blocks login)

# Cloudinary unsigned upload (public preset — not an API secret)
VITE_CLOUDINARY_UPLOAD_URL=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Auth debug: in production console:
#   localStorage.setItem('DEBUG_API_AUTH','1'); location.reload();
# After a failed API: __healthlynkCopyAuthReport()  — copies JSON for backend team
# Or: Network → request → Headers → Request Headers → Cookie (httpOnly JWT only visible there)
