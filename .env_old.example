# pVerify (test) — copy to `.env` and fill in values.
# Never commit `.env`. Note: any `VITE_*` value is embedded in the browser bundle;
# for production, call pVerify from your backend and keep secrets server-side.

# API host (no trailing slash). For local dev, leave empty to use the Vite proxy
# and avoid browser CORS issues (see vite.config.js → /pverify-api).
VITE_PVERIFY_API_BASE=

# HealthLynk backend API base URL (required in production/deployment).
# Local dev can still use Vite proxy via /api.
# Example: https://healthcare-hjdya4cgbfbhb8be.centralus-01.azurewebsites.net/api
VITE_API_BASE_URL=

# OAuth client credentials (Token: POST .../Token, form body client_credentials)
VITE_PVERIFY_CLIENT_ID=
VITE_PVERIFY_CLIENT_SECRET=

# Sent on eligibility and other API calls as the `Client-API-Id` header (often same as client id)
VITE_PVERIFY_CLIENT_API_ID=

# Optional portal username for `Client-User-Name` (Report PDF & other endpoints).
# If unset, the app sends the same value as Client-API-Id.
# VITE_PVERIFY_CLIENT_USER_NAME=

# Eligibility POST path (from pVerify Postman). Example:
# VITE_PVERIFY_ELIGIBILITY_PATH=/api/EligibilitySummary
VITE_PVERIFY_ELIGIBILITY_PATH=
# PDF prefix path (without trailing slash). Example:
# VITE_PVERIFY_ELIGIBILITY_PDF_PREFIX=/API/Report/EligibilityPDFReport
VITE_PVERIFY_ELIGIBILITY_PDF_PREFIX=

# PDF report (GET /Report/EligibilityPDFReport/{RequestID}) uses the same base URL,
# token, and Client-API-Id as other APIs — no extra env vars.

# Optional EligibilitySummary fields (defaults exist in code)
# VITE_PVERIFY_PRACTICE_TYPE_CODE=3
# VITE_PVERIFY_LOCATION=

# Azure Document Intelligence — health insurance card (analyze from URL after Cloudinary upload)
# Never commit real keys. VITE_* is embedded in the browser; use a backend proxy in production.
VITE_AZURE_DOC_INTEL_ANALYZE_URL=
VITE_AZURE_DOC_INTEL_KEY=

# Healthify NPI endpoint (optional override)
# If empty, app uses `${VITE_API_BASE_URL}/integrations/npi`.
# Example:
# VITE_HEALTHIFY_NPI_URL=https://healthlynkapi-e9dzgrfgaebvhre4.centralus-01.azurewebsites.net/api/integrations/npi
VITE_HEALTHIFY_NPI_URL=

# Stedi eligibility API
VITE_STEDI_API_URL=
# Prefer VITE_STEDI_API_KEY, fallback is VITE_STEDI_CLIENT_KEY
VITE_STEDI_API_KEY=
VITE_STEDI_CLIENT_KEY=

# Cloudinary unsigned upload
VITE_CLOUDINARY_UPLOAD_URL=
VITE_CLOUDINARY_UPLOAD_PRESET=
